# Copy to .env and fill in. Never commit .env.

# --- Telegram -----------------------------------------------------------
# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (message @userinfobot to get it).
# Only this user can submit links and approve clips.
TELEGRAM_OWNER_ID=
# Friends who may use the bot too (numeric ids from @userinfobot, comma-separated)
TELEGRAM_ALLOWED_USERS=
# The group chat the bot works in (find it with /chatid in the group). Once set, the bot only reacts
# in this group: private messages are ignored. Empty: it works in private chat (for setup).
TELEGRAM_CHAT_ID=
# Only if Telegram blocks or rate-limits your server: a relay URL (see README, "Telegram relay")
TELEGRAM_API_BASE=

# --- Storage paths ------------------------------------------------------
DATA_DIR=./data
# Local copies of final clips are kept this many days (the posting step reuses them)
LOCAL_RETENTION_DAYS=10

# --- Clip judge ---------------------------------------------------------
# Primary: Gemini free tier (Google AI Studio key)
GEMINI_API_KEY=
# If this name isn't available for your key, the best available Flash model is picked automatically
GEMINI_MODEL=gemini-flash-latest
# Fallback: Claude Haiku 5.5, used only when Gemini fails
ANTHROPIC_API_KEY=
FALLBACK_MODEL=claude-haiku-5-5
# Hard monthly cap for fallback spend; above it, jobs wait for Gemini instead
FALLBACK_MONTHLY_CAP_USD=2

# --- Transcription ------------------------------------------------------
WHISPER_MODEL=small.en
WHISPER_COMPUTE_TYPE=int8
# Leave empty to use every CPU core
WHISPER_THREADS=

# --- Clip selection -----------------------------------------------------
CLIPS_PER_VIDEO=12
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=60
MAX_SOURCE_HOURS=6
# Gemini watches frames of the best candidates and ranks them (one extra request per video)
VISION_REVIEW=1
VISION_CANDIDATES=20

# --- Download -----------------------------------------------------------
# Netscape-format cookies file for YouTube (needed on most datacenter IPs)
YTDLP_COOKIES=
# Keep the last stream's download + transcript, so re-running the same link is quick (~7 GB for a 2 h VOD)
KEEP_LAST_SOURCE=1

# --- Twitch signals (VODs) ----------------------------------------------
# Free app at https://dev.twitch.tv/console/apps (category: Application Integration,
# OAuth redirect http://localhost). Enables "moments viewers clipped" for VODs.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Read the VOD's chat replay for reaction bursts (no credentials needed). 0 to disable.
TWITCH_CHAT=1

# --- Layout -------------------------------------------------------------
# YuNet face model (scripts/fetch_models.sh downloads it)
FACE_MODEL_PATH=./data/models/face_detection_yunet_2023mar.onnx
# Optional per-channel crop presets (see presets.example.json)
PRESETS_PATH=./presets.json

# --- Posting ----------------------------------------------------------------
# Instagram (professional account, Meta app with "API setup with Instagram login"):
# the long-lived token from "Generate token". Refreshed automatically after that.
INSTAGRAM_ACCESS_TOKEN=
# Approved clips are spread over the day: this many per platform, inside this local window
POSTS_PER_DAY=15
POST_WINDOW=10:00-23:00
POST_TZ=Asia/Yerevan
# Optional text added under every caption (e.g. "Follow for more")
CAPTION_SUFFIX=

# --- Cloudflare R2 (needed for Instagram: it fetches the video from a public URL) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
R2_RETENTION_DAYS=10
